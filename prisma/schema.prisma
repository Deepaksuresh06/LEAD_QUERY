generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  owner
  admin
  manager
  agent
}

enum CustomFieldType {
  string
  number
  date
  boolean
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  leads        Lead[]
  customFields CustomField[]

  @@map("tenants")
}

model User {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String
  email    String
  role     UserRole

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdLeads  Lead[] @relation("LeadCreator")
  assignedLeads Lead[] @relation("LeadAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Lead {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String
  phone        String
  countryCode  String    @map("country_code")
  e164         String
  email        String?
  assignedTo   String?   @map("assigned_to") @db.Uuid
  followUpDate DateTime? @map("follow_up_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  User   @relation("LeadCreator", fields: [userId], references: [id])
  assignee User?  @relation("LeadAssignee", fields: [assignedTo], references: [id])

  customFieldValues LeadCustomFieldValue[]

  @@index([tenantId])
  @@index([tenantId, assignedTo])
  @@index([tenantId, createdAt])
  @@index([tenantId, followUpDate])
  @@index([tenantId, email])
  @@map("leads")
}

model CustomField {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  label    String
  type     CustomFieldType
  status   Boolean         @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  values LeadCustomFieldValue[]

  @@unique([tenantId, label])
  @@index([tenantId, status])
  @@map("custom_fields")
}

model LeadCustomFieldValue {
  id      String @id @default(uuid()) @db.Uuid
  leadId  String @map("lead_id") @db.Uuid
  fieldId String @map("field_id") @db.Uuid
  value   String

  lead  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([fieldId])
  @@index([leadId])
  @@index([fieldId, value])
  @@map("lead_custom_field_values")
}
